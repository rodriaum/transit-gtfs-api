# Tranzor API - Environment Variables

# ===========================================
# PostgreSQL
# ===========================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tranzor
DB_USERNAME=tranzor
DB_PASSWORD=tranzor123

# ===========================================
# REDIS
# ===========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ===========================================
# CASSANDRA
# ===========================================
CASSANDRA_HOST=localhost
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=tranzor
CASSANDRA_DATACENTER=datacenter1

# ===========================================
# OPEN TRIP PLANNER
# ===========================================
OTP_BASE_URL=http://localhost:8081/otp
OTP_TIMEOUT=30000

# ===========================================
# JWT
# ===========================================
JWT_SECRET=change-this-to-a-very-long-random-secret-key-at-least-256-bits-long
JWT_EXPIRATION=86400000

# ===========================================
# APPLICATION
# ===========================================
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# ===========================================
# TRANZOR SPECIFIC
# ===========================================
TRANZOR_GTFS_STORAGE_PATH=/data/gtfs
TRANZOR_GTFS_TEMP_PATH=/tmp/gtfs
TRANZOR_GTFS_AUTO_IMPORT=true
TRANZOR_AGENCIES_CONFIG_URL=file:///data/agencies.json

# Cache TTL
TRANZOR_CACHE_NEARBY_STOPS_TTL=3600
TRANZOR_CACHE_DEPARTURES_TTL=60
TRANZOR_CACHE_ROUTES_TTL=1800

# Search defaults
TRANZOR_SEARCH_DEFAULT_RADIUS=500
TRANZOR_SEARCH_MAX_RADIUS=5000
TRANZOR_SEARCH_MAX_RESULTS=50
